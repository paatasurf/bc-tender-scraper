# Local developer overrides — copy to .env.local (gitignored).
# DATABASE_URL here wins over .env for CLI scripts on your machine.
# Railway production URL belongs in .env as DATABASE_URL_PRODUCTION, never here.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bc_tenders

# Staging gate (API-only — never point DATABASE_URL at Railway)
# TENDERSCOPE_API_URL=https://your-app.up.railway.app
# INTERNAL_API_KEY=your-internal-key
