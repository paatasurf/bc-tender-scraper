{
  "name": "TenderScope — Deadline Alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        },
        "timezone": "America/Vancouver"
      },
      "id": "d1a2b3c4-1111-4000-8000-000000000001",
      "name": "Daily 08:00 Vancouver",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "notes": "Runs every day at 08:00 America/Vancouver (PST/PDT)."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "base-url",
              "name": "baseUrl",
              "value": "https://bc-tender-scraper-production.up.railway.app",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "d1a2b3c4-1111-4000-8000-000000000002",
      "name": "Set API Base URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl }}/internal/deadline-alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "d1a2b3c4-1111-4000-8000-000000000003",
      "name": "Send Deadline Alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "notes": "POST /internal/deadline-alerts — scans client_profiles + tender_matches and sends Resend emails."
    }
  ],
  "connections": {
    "Daily 08:00 Vancouver": {
      "main": [
        [
          {
            "node": "Set API Base URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set API Base URL": {
      "main": [
        [
          {
            "node": "Send Deadline Alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "REPLACE_WITH_ERROR_WORKFLOW_ID"
  },
  "staticData": null,
  "tags": [
    {
      "name": "tenderscope-monitoring"
    }
  ],
  "triggerCount": 1,
  "meta": {
    "templateCredsSetupCompleted": false,
