{
  "name": "TenderScope — AI Scoring (sync)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7,13,19 * * *"
            }
          ]
        }
      },
      "id": "f1a2b3c4-1111-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "notes": "Runs at 7:00, 13:00, and 19:00 daily (server timezone)."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "base-url",
              "name": "baseUrl",
              "value": "https://bc-tender-scraper-production.up.railway.app",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "f1a2b3c4-1111-4000-8000-000000000002",
      "name": "Set API Base URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl }}/internal/ai-scoring?sync=true",
        "options": {
          "timeout": 600000
        }
      },
      "id": "f1a2b3c4-1111-4000-8000-000000000003",
      "name": "1. Run AI Scoring (sync)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "notes": "Blocking run — waits for completion and returns counts. Requires ALLOW_MANUAL_PIPELINE=true. Batch size capped at AI_SCORING_MAX_PER_RUN (default 10 per table)."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "status-check",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f1a2b3c4-1111-4000-8000-000000000006",
      "name": "Scoring Finished OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=✅ AI Scoring complete\n\nTenders scored (total): {{ $json.counts.total_tenders_scored }}\nCommercial/provincial: {{ $json.counts.commercial_tenders_scored }}\n  • MERX/provincial: {{ $json.counts.merx_tenders_scored }}\n  • BidCentral: {{ $json.counts.bidcentral_tenders_scored }}\nFederal (CanadaBuys): {{ $json.counts.federal_gov_tenders_scored }}\nArchitecture: {{ $json.counts.arch_tenders_scored }}\n\nBacklog remaining: {{ JSON.stringify($json.counts.backlog) }}\nStatus: {{ $json.status }}\nRun ID: {{ $json.run_id }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "f1a2b3c4-1111-4000-8000-000000000007",
      "name": "2. Telegram Success",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 180],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\n\nfunction uuidv4() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {\n    const r = (Math.random() * 16) | 0;\n    const v = c === 'x' ? r : (r & 0x3) | 0x8;\n    return v.toString(16);\n  });\n}\n\nconst errorMsg = r.error || `status=${r.status}`;\nconst incident_key = `ai-scoring:failed:${r.run_id || 'unknown'}`;\n\nreturn [\n  {\n    json: {\n      incident_id: uuidv4(),\n      incident_key,\n      severity: 'high',\n      source: 'n8n-ai-scoring',\n      step: 'ai-scoring',\n      timestamp: new Date().toISOString(),\n      summary: 'AI scoring step failed or returned non-success status',\n      error: errorMsg,\n      context: {\n        step: 'ai-scoring',\n        run_id: r.run_id,\n        pipeline_run_id: r.pipeline_run_id,\n        status: r.status,\n        counts: r.counts,\n        poll_url: r.poll_url,\n      },\n    },\n  },\n];"
      },
      "id": "f1a2b3c4-1111-4000-8000-000000000009",
      "name": "Prepare Incident Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INCIDENT_ROUTER_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "f1a2b3c4-1111-4000-8000-000000000008",
      "name": "Forward to Incident Router",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 420],
      "notes": "Set INCIDENT_ROUTER_WEBHOOK_URL to the Incident Router workflow Production webhook URL."
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Set API Base URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set API Base URL": {
      "main": [
        [
          {
            "node": "1. Run AI Scoring (sync)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "1. Run AI Scoring (sync)": {
      "main": [
        [
          {
            "node": "Scoring Finished OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scoring Finished OK?": {
      "main": [
        [
          {
            "node": "2. Telegram Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Prepare Incident Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Incident Payload": {
      "main": [
        [
          {
            "node": "Forward to Incident Router",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "REPLACE_WITH_ERROR_WORKFLOW_ID"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "POST /internal/ai-scoring?sync=true — blocking run with counts in response. No polling. Default batch 10 per table (AI_SCORING_MAX_PER_RUN)."
  }
}
