          "timeout": 360000
        }
      },
      "id": "m1a2b3c4-1111-4000-8000-000000000003",
      "name": "Send Morning Brief",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "notes": "Calls POST /internal/morning-brief. Voice agent + Resend run synchronously — allow up to 6 min."
