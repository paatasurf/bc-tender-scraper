          ]
        },
        "timezone": "America/Vancouver"
      },
      "id": "m1a2b3c4-1111-4000-8000-000000000001",
      "name": "Daily 07:00 Vancouver",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "notes": "Runs every day at 07:00 America/Vancouver (PST/PDT)."
    },
    {
      "parameters": {
