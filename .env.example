# PostgreSQL (Railway injects DATABASE_URL when you link a Postgres plugin)
# Railway private URL example: postgresql://postgres:pass@postgres.railway.internal:5432/railway
# The app auto-adds sslmode=require for Railway hosts.
DATABASE_URL=postgresql://user:password@localhost:5432/bc_tenders

# DB retry tuning (Postgres recovery after disk pressure can take several minutes)
DB_INIT_RETRIES=30
DB_INIT_RETRY_DELAY=2
DB_INIT_RETRY_MAX_DELAY=30
DB_REQUEST_RETRIES=5
DB_REQUEST_RETRY_DELAY=1
DB_REQUEST_RETRY_MAX_DELAY=10

# API
PORT=8000
CORS_ORIGINS=*

# Scheduler (runs scrapers + DB import daily at 6 AM Pacific)
SCHEDULER_ENABLED=true
SCHEDULE_TIMEZONE=America/Vancouver
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=0

# Set to true to allow POST /api/pipeline/run for manual runs
ALLOW_MANUAL_PIPELINE=false

# Claude API key for AI tender scoring and budget estimates (set in Railway service variables)
ANTHROPIC_API_KEY=

# Pipeline tuning for memory-constrained Railway deployments
# Skip the 50k+ building permits scrape (still imports existing building_permits.csv)
PIPELINE_SKIP_BUILDING_PERMITS=false
# Skip Claude scoring during pipeline (run multiple times to score in batches)
PIPELINE_SKIP_AI_SCORING=false
# Max tenders to AI-score per pipeline run (default 50; re-run pipeline to continue)
AI_SCORING_MAX_PER_RUN=50

# AI matching (POST /api/ai-matching) — matcher + scorer agents (claude-haiku-4-5)
AI_MATCHING_MAX_COMPANIES=10
AI_MATCHING_MAX_TENDERS=50
AI_MATCHING_DELAY_SECONDS=1
