# PostgreSQL — LOCAL by default for CLI scripts (see .env.local.example)
DATABASE_URL=postgresql://user:password@localhost:5432/bc_tenders

# Production Railway Postgres — NEVER use as DATABASE_URL for local scripts.
# Only used when a script is invoked with --allow-production (destructive)
# or --use-production (read-only audit).
# Railway injects DATABASE_URL at runtime on the deployed service; this var is for local CLI only.
DATABASE_URL_PRODUCTION=

# Railway private URL example: postgresql://postgres:pass@postgres.railway.internal:5432/railway
# The app auto-adds sslmode=require for Railway hosts.

# DB retry tuning (Postgres recovery after disk pressure can take several minutes)
DB_INIT_RETRIES=30
DB_INIT_RETRY_DELAY=2
DB_INIT_RETRY_MAX_DELAY=30
DB_REQUEST_RETRIES=5
DB_REQUEST_RETRY_DELAY=1
DB_REQUEST_RETRY_MAX_DELAY=10

# API
PORT=8000
# Comma-separated allowlist of allowed browser origins.
# '*' allows any origin for NON-credentialed requests only (public dashboard
# data). Credentialed cross-origin requests (Authorization header / cookies)
# are only permitted when CORS_ORIGINS is an explicit allowlist — a wildcard
# with credentials is refused to prevent any site from making authenticated
# requests on a user's behalf.
# Example: CORS_ORIGINS=https://app.tenderscope.ca,https://tenderscope.ca
CORS_ORIGINS=*

# Scheduler (runs full pipeline daily at 6 AM Pacific via APScheduler in the web process)
SCHEDULER_ENABLED=true
SCHEDULE_TIMEZONE=America/Vancouver
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=0

# Set to true to allow manual/automation runs of pipeline + scrape endpoints
# (POST /api/pipeline/*, /internal/scrape/*, GET /api/scrape/surrey-permits,
#  GET /api/scrape/burnaby-permits). Defaults to false so these are NOT public.
ALLOW_MANUAL_PIPELINE=false

# Clerk authentication for the Company Intelligence plan gate.
# JWT verification needs ONE of:
#   CLERK_PUBLISHABLE_KEY (pk_*) — verifies session tokens via public Frontend JWKS
#   CLERK_JWT_KEY — optional PEM public key for networkless verification
#   CLERK_JWKS_URL — explicit JWKS endpoint override
#   CLERK_ISSUER — optional expected token issuer (https://...). The token's
#     own `iss` is only trusted for JWKS lookup when its host matches the
#     publishable-key domain, CLERK_JWKS_URL, or CLERK_ISSUER.
# Backend API user lookups (plan metadata refresh) require:
#   CLERK_SECRET_KEY (sk_*) — NOT the publishable pk_* key
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...
# CLERK_JWKS_URL=https://clerk.example.com/.well-known/jwks.json
# CLERK_ISSUER=https://clerk.example.com
# CLERK_AUTHORIZED_PARTIES=https://your-frontend.example.com

# Claude API key for AI tender scoring and budget estimates (set in Railway service variables)
ANTHROPIC_API_KEY=

# Pipeline tuning for memory-constrained Railway deployments
# Skip the 50k+ building permits scrape (still imports existing building_permits.csv)
PIPELINE_SKIP_BUILDING_PERMITS=false
# Skip MERX BC open tender scrape merged into tenders.csv (federal tenders still collected)
PIPELINE_SKIP_MERX=false
# Optional Telegram alerts (general pipeline notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (Resend API — POST /internal/send-alerts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@tenderscope.ca

# Morning brief (POST /internal/morning-brief — voice agent + Resend)
VOICE_AGENT_URL=https://voice-n8n-agent-production.up.railway.app
# Skip Claude scoring during pipeline (run multiple times to score in batches)
PIPELINE_SKIP_AI_SCORING=false
# Max tenders to AI-score per pipeline run (default 50; re-run pipeline to continue)
AI_SCORING_MAX_PER_RUN=10

# Contract awards import (CanadaBuys fiscal years, comma-separated)
CONTRACT_AWARDS_FEDERAL_YEARS=2025-2026,2024-2025,2023-2024,2022-2023

# Internal API (POST /internal/google-enrichment/run, GET /internal/google-enrichment/metrics)
INTERNAL_API_KEY=

# Google Business enrichment (deterministic ETL — no LLM)
GOOGLE_PROVIDER=apify
GOOGLE_PROVIDER_FALLBACK=none
APIFY_TOKEN=
APIFY_ACTOR_ID=compass/google-maps-extractor
GOOGLE_ENRICHMENT_STALE_DAYS=30
GOOGLE_ENRICHMENT_BATCH_SIZE=21
GOOGLE_ENRICHMENT_CONFIDENCE_ACCEPT=0.70
GOOGLE_ENRICHMENT_CONFIDENCE_REVIEW=0.55
GOOGLE_ENRICHMENT_NO_MATCH_RETRY_DAYS=90
GOOGLE_COPY_WEBSITE_TO_WEBSITE=false
OSS_SCRAPER_URL=
AI_MATCHING_MAX_COMPANIES=10
AI_MATCHING_MAX_TENDERS=50
AI_MATCHING_DELAY_SECONDS=1
